# Plain-env path (no 1Password). Copy to .env and fill in your own values.
# run.sh sources this automatically when OP_SERVICE_ACCOUNT_TOKEN is not set.
# .env is gitignored — never commit real keys.
#
# Required for ingest + real search. The local zero-key demo (quickstart/)
# needs NONE of these.

# ─── Database (Postgres + PostgREST, e.g. a Supabase project) ─────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# ─── Voyage embeddings ────────────────────────────────────────────
VOYAGE_API_KEY=your-voyage-api-key

# ─── Contextual Retrieval provider (anthropic OR deepseek) ────────
ANTHROPIC_API_KEY=your-anthropic-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── Local config (non-secret; sensible defaults shown) ───────────
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
CONTEXTUAL_PROVIDER=deepseek
CONTEXTUAL_HAIKU_MODEL=claude-haiku-4-5-20251001
CONTEXTUAL_DEEPSEEK_MODEL=deepseek-chat
CONTEXTUAL_PARALLEL=8
RERANKER_MODEL=rerank-2.5-lite
DEFAULT_OWNER=owner

# ─── Optional display/behavior knobs (defaults shown) ─────────────
#CB_PRODUCT_NAME=Corpus
#CB_CLI_NAME=cb
#CB_OWNER_LABEL=owner
#DRY_RUN=false
