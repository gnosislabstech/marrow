# Runtime environment template — 1Password path.
# Resolved by `op run --env-file=.env.tmpl` via run.sh. Committed to git: these
# are op:// references, not secret values. Replace <vault> with your 1Password
# vault name. Not using 1Password? Copy .env.example to .env instead — run.sh
# falls back to a plain .env when no 1Password token is present.

# ─── Database (Postgres + PostgREST, e.g. Supabase) ───────────────
SUPABASE_URL=op://<vault>/database/url
SUPABASE_SERVICE_KEY=op://<vault>/database/service_key
SUPABASE_ANON_KEY=op://<vault>/database/anon_key
SUPABASE_PROJECT_REF=op://<vault>/database/project_ref

# ─── Voyage embeddings ────────────────────────────────────────────
VOYAGE_API_KEY=op://<vault>/voyage/api_key

# ─── Anthropic (Contextual Retrieval — anthropic provider path) ───
ANTHROPIC_API_KEY=op://<vault>/anthropic/api_key

# ─── DeepSeek (Contextual Retrieval — deepseek provider path) ─────
# Cheaper than Haiku for the same task; auto-caches repeated prefixes.
DEEPSEEK_API_KEY=op://<vault>/deepseek/api_key

# ─── Local config (non-secret) ────────────────────────────────────
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
CONTEXTUAL_PROVIDER=deepseek
CONTEXTUAL_HAIKU_MODEL=claude-haiku-4-5-20251001
CONTEXTUAL_DEEPSEEK_MODEL=deepseek-chat
CONTEXTUAL_PARALLEL=8
RERANKER_MODEL=rerank-2.5-lite
DEFAULT_OWNER=owner
